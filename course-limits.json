            "probe": {
                "keys": [
                    "limit",
                    "value"
                ],
                "answer": [
                    4,
                    9
                ],
                "feedback": "The hidden rule is 4 + (x − 2)² + (x − 2)/2 except at x = 2, where it equals 9. Both variable terms tend to zero, so both sides approach 4.",
                "hint": "Take measurements closer to 2 from both sides, and also query 2 itself."
            },
            "hole": {
                "keys": [
                    "limit",
                    "value"
                ],
                "answer": [
                    6,
                    "undefined"
                ],
                "feedback": "For x ≠ 3, g(x) = x + 3. Its limit is 6, but the original denominator is zero at 3.",
                "hint": "Factor the numerator; keep track of the excluded input."
            },
            "precision": {
                "keys": [
                    "delta"
                ],
                "answer": [
                    0.04
                ],
                "feedback": "A valid radius is 0.04: the endpoint squares are 3.8416 and 4.1616, both inside the band. The largest possible radius is √4.2 − 2 ≈ 0.04939.",
                "hint": "Check both ends of the interval, not just its centre.",
                "limitModel": "precision"
            }
        },
